LOG_LEVEL=INFO

# Cache backend: "local" (in-memory, single process) or "redis" (shared
# across workers)
CACHE_BACKEND=local
CACHE_TTL_SECONDS=300

# Required when CACHE_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0

# Comma-separated CORS origins. Not needed in production (Uvicorn serves
# the frontend) or in dev (Vite proxy forwards /v1 server-side, no
# cross-origin request reaches the browser). Set only when deploying
# backend and frontend on separate origins.
# CORS_ORIGINS=http://localhost:5173

# Market data providers — JSON list, in fallback order (first = default)
# Available: yahoo, alphavantage
# Multiple providers: MARKET_DATA_PROVIDERS=["alphavantage","yahoo"]
MARKET_DATA_PROVIDERS=["yahoo"]

# Required when alphavantage is in MARKET_DATA_PROVIDERS
# ALPHA_VANTAGE_API_KEY=your_key_here

# OpenTelemetry - set OTEL_ENABLED=true when a collector is reachable
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=pestoengine
# OTEL_EXPORT_INTERVAL_MS=60000
# Comma-separated key=value pairs, URL-encoded values (e.g. Grafana Cloud)
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64token>
